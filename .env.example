PORT=5000
NODE_ENV=development

# Base de datos libSQL / Turso
# Para desarrollo local (dejar vacío para usar SQLite local nexbyte.db):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
LOCAL_DB_PATH=./nexbyte.db

# Autenticación y Seguridad
JWT_SECRET=nexbyte_secret_key_production_2026_super_secure
JWT_EXPIRES_IN=7d
COOKIE_SECRET=nexbyte_cookie_key_production_2026

# Administrador Inicial
ADMIN_EMAIL=nexbyte.ok@gmail.com
ADMIN_INITIAL_PASSWORD=Nexbyte2026!Admin

# Cloudinary (Opcional - Si no se configura, almacena localmente en uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Configuración Regional
TIMEZONE=America/Argentina/Cordoba
COMPANY_NAME=NEXBYTE
